# Probe image with several builds (DECISIONS.md, "Scorer probes"), used only on a
# probe branch: probe/make_variants.sh puts each commit's native/src in
# probe/variants/<name>/; each is built for x86-64-v3, and those with a file
# named "base" also for the default CPU. The first variant's v3 unit tests are built too.
FROM rust:1.96-bookworm AS build
WORKDIR /src
COPY native/Cargo.toml native/Cargo.lock ./
RUN mkdir src && echo 'fn main() {}' > src/main.rs && cargo fetch --locked
COPY probe/variants /variants
RUN mkdir /bin-out && T=x86_64-unknown-linux-gnu && first=1 && for v in $(ls /variants); do \
      rm -rf src && cp -r /variants/$v/src src && \
      if [ -f /variants/$v/base ]; then cargo build --release --locked --offline --bin shopping && cp target/release/shopping /bin-out/$v-base; fi && \
      if [ "$(uname -m)" = x86_64 ]; then \
        RUSTFLAGS="-C target-cpu=x86-64-v3" cargo build --release --locked --offline --bin shopping --target $T --target-dir /t3 && cp /t3/$T/release/shopping /bin-out/$v-v3 && \
        if [ -f /variants/$v/v4 ]; then RUSTFLAGS="-C target-cpu=x86-64-v4" cargo build --release --locked --offline --bin shopping --target $T --target-dir /t4 && cp /t4/$T/release/shopping /bin-out/$v-v4; fi && \
        if [ $first = 1 ]; then \
          RUSTFLAGS="-C target-cpu=x86-64-v3" cargo test --release --locked --offline --bin shopping --target $T --target-dir /t3 --no-run 2>&1 | tee /tmp/t.log && \
          cp "$(sed -n 's/.*(\(\/t3\/[^)]*\)).*/\1/p' /tmp/t.log | head -1)" /bin-out/tests-v3; fi; \
      else cargo build --release --locked --offline --bin shopping && cp target/release/shopping /bin-out/$v-v3; fi && \
      first=0; done && ls -la /bin-out
# The writer (this branch's own code, default CPU) writes the dev output and the report rows.
COPY native/src /writer-src
RUN rm -rf src && cp -r /writer-src src && cargo build --release --locked --offline --bin shopping && cp target/release/shopping /writer
WORKDIR /gen
COPY probe/generator/ ./
RUN cargo build --release && cp target/release/generate /generate

FROM debian:bookworm-slim
COPY --from=build /bin-out /app/bin
COPY --from=build /generate /app/generate
COPY --from=build /writer /app/writer
COPY probe/run_rows.sh /app/run.sh
COPY probe/configs probe/probe60 /app/
CMD ["/bin/bash", "/app/run.sh"]
